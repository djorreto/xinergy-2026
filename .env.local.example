# Optional: override Monday form region if needed
# Contact form submits via /api/contact (native UI, no iframe)

# Google Analytics 4 — create at https://analytics.google.com → Admin → Data streams → Web
# Copy the Measurement ID (G-XXXXXXXXXX) from your xinergy.lat stream:
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Ads — global tag on all pages (public ID, safe in client code)
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-18294572204

# Optional: conversion event when contact form is submitted successfully.
# Create the action in Google Ads → Objetivos → Conversiones → Nueva conversión → Sitio web → Evento.
# Google gives you a label like AbCdEfGhIjK; set the full send_to value here:
# NEXT_PUBLIC_GOOGLE_ADS_CONTACT_CONVERSION=AW-18294572204/AbCdEfGhIjK
#
# To count visits to /contacto without extra code, create a separate conversion in Google Ads
# with rule "URL contains contacto" — the global tag above is enough for that.
