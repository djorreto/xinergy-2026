# Optional: override Monday form region if needed
# Contact form submits via /api/contact (native UI, no iframe)

# Google Analytics 4 — Measurement ID from Admin → Data streams → Web (Xinergy.cl)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-LMXEEPBX2S

# Google Ads — global tag on all pages (public ID, safe in client code)
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-18294572204

# Google Ads — contact form conversion (fires on successful submit via trackContactLead)
NEXT_PUBLIC_GOOGLE_ADS_CONTACT_CONVERSION=AW-18294572204/Z0tUCJjp_tocEKyJxJNE

# Metricool web tracker hash (from Metricool → Conexión con la Web)
NEXT_PUBLIC_METRICOOL_HASH=caefbfbf6e94f2c32c963e33011835c

# Public site URL used in download emails outside localhost
NEXT_PUBLIC_SITE_URL=https://xinergy.lat

# Proyecto Supabase propio de xinergy.lat (contenido, PDFs y acceso del admin)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
INSIGHTS_SERVER_EMAIL=insights-server@xinergy.lat
INSIGHTS_SERVER_PASSWORD=
INSIGHTS_SESSION_SECRET=

# Dominios que pueden pedir un código para el admin de Insights
ALLOWED_EMAIL_DOMAINS=xinergy.cl,duxpartners.com,opticks.cl

# Traducción de insights en el admin (botón, no automática)
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Envío del código de acceso y del correo de descarga
RESEND_API_KEY=
INSIGHTS_FROM_EMAIL=Xinergy <reportes@send.xinergy.cl>

# Monday CRM — workspace CRM EQUIPO COMERCIAL. Creates/uses the board INSIGHTS | DESCARGAS
MONDAY_API_TOKEN=
MONDAY_WORKSPACE_NAME=CRM EQUIPO COMERCIAL

# Optional Cloudflare Turnstile. If both are empty, honeypot + rate limit + email confirmation still apply.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
